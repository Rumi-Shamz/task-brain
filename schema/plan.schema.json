{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi-shamz.github.io/task-brain/schema/plan.schema.json",
  "title": "WeeklyPlan",
  "type": "object",
  "required": ["version", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "weekOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/planItem" }
    }
  },
  "$defs": {
    "domain": {
      "type": "string",
      "enum": ["ALFA", "Dorst", "SwingShuffle", "SwingSociety", "SoftwareDev", "Personal", "Other"]
    },
    "timepressure": {
      "type": "string",
      "enum": ["urgent", "important"]
    },
    "length": {
      "type": "integer",
      "enum": [15, 30, 60, 180]
    },
    "status": {
      "type": "string",
      "enum": ["todo", "done", "someday"]
    },
    "slot": {
      "type": "string",
      "enum": ["morning", "afternoon", "evening"]
    },
    "activity": {
      "type": "string",
      "enum": ["research", "communicate", "act", "learn"]
    },
    "lno": {
      "type": "string",
      "enum": ["L", "N", "O"]
    },
    "weekday": {
      "type": "string",
      "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    },
    "planItem": {
      "type": "object",
      "required": ["name", "domain"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/domain" },
        "project": { "type": "string", "minLength": 1 },
        "activity": { "$ref": "#/$defs/activity" },
        "lno": { "$ref": "#/$defs/lno" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 3 },
        "timepressure": { "$ref": "#/$defs/timepressure" },
        "slot": { "$ref": "#/$defs/slot" },
        "weekday": { "$ref": "#/$defs/weekday" },
        "length": { "$ref": "#/$defs/length" },
        "sessions": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "reviewAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
